# APEX GATE backend environment
DATABASE_URL=sqlite+aiosqlite:///./apex_gate.db
AUTH_DATABASE_URL=sqlite+aiosqlite:///./apex_gate_auth.db

# Secrets — generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-to-a-fernet-key

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Server
PROXY_HOST=0.0.0.0
PROXY_PORT=8000

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Scheduler
DISCOVERY_INTERVAL_HOURS=6
LOG_RETENTION_DAYS=90
